#!/usr/bin/env groovy

/*
 * Pipeline: metadata-fetch-publish
 *
 * Runs on trusted.ci.jenkins.io (scheduled daily at ~3 AM UTC).
 * Fetches jenkins-infra/metadata-plugin-modernizer, transforms data,
 * and publishes to reports.jenkins.io/plugin-modernizer-stats/
 *
 * Script path: Jenkinsfile.fetch-publish
 *
 * References:
 *   - jenkins-infra/pipeline-library vars/publishReports.groovy
 *   - jenkins-infra/repository-permissions-updater/Jenkinsfile  (publishReports pattern)
 *   - jenkins-infra/pipeline-steps-doc-generator/Jenkinsfile    (infra.publishReports pattern)
 */

properties([
    pipelineTriggers([
        cron('H 1 * * 0'),
    ]),
    buildDiscarder(logRotator(numToKeepStr: '10')),
])

// Fix #6: use an explicit flag rather than `return` inside a stage block.
// In a scripted pipeline, `return` exits the stage *closure* but does NOT
// stop subsequent stages from running.  A boolean flag checked at the top
// of each stage is the idiomatic scripted-pipeline early-exit pattern.
def dataChanged = true

node('linux') {

    // Fix #11: wrap everything in try/finally so we always send a failure
    // notification and always attempt workspace cleanup, even on error.
    try {

        stage('Checkout') {
            checkout scm
        }

        stage('Fetch Metadata') {
            sh 'bash scripts/fetch-metadata-plugin-modernizer.sh'

            // The fetch script validates the extracted directory itself.
            // We only need to check for the sentinel file here to decide
            // whether to skip the rest of the pipeline on a 304 hit.
            if (!fileExists('.tmp/metadata-plugin-modernizer-main/reports/summary.md')) {
                echo 'Data unchanged (ETag 304 cache hit) — skipping Transform and Publish.'
                currentBuild.result = 'NOT_BUILT'
                dataChanged = false
            }
        }

        // Fix #6: every subsequent stage is gated on the dataChanged flag
        // so the pipeline genuinely short-circuits rather than just exiting
        // a single stage closure.
        if (dataChanged) {

            stage('Transform Data') {
                // OUTPUT_DIR must match the directory name expected by the
                // Validate JSON and Package stages below.  The default inside
                // consolidate.py is 'plugin-modernizer-stats', so we set it
                // explicitly here to make the contract visible and to guard
                // against the default changing upstream (issue #9 — left as-is
                // per instructions but the explicit set keeps things clear).
                withEnv(['OUTPUT_DIR=plugin-modernizer-stats']) {
                    sh 'python3 --version'
                    sh 'python3 scripts/consolidate.py'
                }
            }

            stage('Validate JSON') {
                // Independent second-pass JSON validation after consolidate.py's
                // own post-write round-trip check.
                sh '''
                    set -euo pipefail
                    python3 -m json.tool < plugin-modernizer-stats/summary.json > /dev/null
                    echo "OK: summary.json is valid JSON"
                    python3 -m json.tool < plugin-modernizer-stats/plugin-recipes-index.json > /dev/null
                    echo "OK: plugin-recipes-index.json is valid JSON"
                '''
            }

            // Fix #4: publishing is fully delegated to the publishReports
            // shared library step from jenkins-infra/pipeline-library.
            // The step internally handles:
            //   • ZIP creation with the correct internal directory layout
            //   • trusted vs non-trusted environment gating
            //   • archiving locally when not on trusted.ci
            // This replaces the inline Package / Validate Package / Publish
            // stages from the original Jenkinsfile and removes the duplicate
            // logic that also existed in publishPluginModernizerStats.groovy.
            stage('Publish') {
                // publishReports is a global step provided by the implicitly
                // loaded pipeline-library on *.ci.jenkins.io controllers.
                // Signature (from pipeline-library vars/publishReports.groovy):
                //   publishReports(List<String> reports, Map options = [:])
                //
                // The step expects files that already exist in the current
                // working directory (or sub-paths relative to it).
                //
                // Real-world usage reference:
                //   jenkins-infra/repository-permissions-updater Jenkinsfile:
                //     publishReports(['*.json'], [useWorkloadIdentity: true])
                //
                //   jenkins-infra/pipeline-steps-doc-generator Jenkinsfile:
                //     infra.publishReports(['allAscii.zip', 'declarative.zip'])
                //
                // We pass the output directory directly (no ZIP step here —
                // publishReports handles packaging internally).
                if (infra.isTrusted()) {
                    publishReports(['plugin-modernizer-stats'], [useWorkloadIdentity: true])
                    echo 'Published to reports.jenkins.io/plugin-modernizer-stats/'
                } else {
                    // On non-trusted controllers (ci.jenkins.io, PR builds):
                    // ZIP and archive locally so the output is still inspectable.
                    sh '''
                        rm -f plugin-modernizer-stats.zip
                        zip -r plugin-modernizer-stats.zip plugin-modernizer-stats/
                    '''
                    archiveArtifacts artifacts: 'plugin-modernizer-stats.zip', fingerprint: true
                    echo 'Non-trusted build: artifact archived locally for inspection.'
                }
            }

        } // end if (dataChanged)

    } catch (err) {
        // Fix #11: mark the build as failed and re-throw so Jenkins records
        // the correct status before the finally block runs.
        currentBuild.result = 'FAILURE'
        throw err

    } finally {

        // Fix #11: send a failure notification so stale-data issues are caught
        // promptly rather than only when someone manually inspects the site.
        // Uses the Jenkins built-in emailext (Email Extension Plugin) which is
        // present on all *.ci.jenkins.io controllers.
        if (currentBuild.result == 'FAILURE') {
            emailext(
                subject: "[Jenkins] FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """\
The plugin-modernizer stats fetch/publish pipeline failed.

Job:   ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
URL:   ${env.BUILD_URL}

Check the console log for details.
""",
                // Adjust the recipient list to match your team's convention.
                // On jenkins-infra projects this is typically the infra mailing list.
                to: 'infra@lists.jenkins-ci.org',
                recipientProviders: [culprits(), requestor()],
            )
        }

        // Always clean up generated workspace artefacts to avoid disk
        // exhaustion on the agent.  The .tmp/ directory (including .etag)
        // is intentionally NOT removed here: if the workspace is persistent
        // (non-ephemeral agent) the ETag file survives to enable 304 caching
        // on the next scheduled run.
        sh '''
            rm -f  plugin-modernizer-stats.zip
            rm -rf plugin-modernizer-stats/
        '''
    }

}
