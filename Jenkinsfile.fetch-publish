#!/usr/bin/env groovy
/*
 * Pipeline A: ETL — transform and publish plugin-modernizer stats
 * Runs daily on trusted.ci.jenkins.io
 *
 * Repository : jenkins-infra/metadata-plugin-modernizer
 * Script path: Jenkinsfile.fetch-publish
 *
 * Design rationale:
 *   This Jenkinsfile lives IN metadata-plugin-modernizer because the
 *   trusted.ci job SCM IS metadata-plugin-modernizer. checkout scm checks
 *   out the data repo directly into the workspace — no separate fetch step,
 *   no clone, no .tmp/ directory. The workspace root IS the data.
 *   scripts/consolidate.py reads from INPUT_DIR=. directly.
 *
 *   This mirrors the infra-statistics pattern: Jenkinsfile and processing
 *   scripts live alongside the data they process in the same repository.
 *
 * Stage references:
 *   properties/cron   : infra-statistics/Jenkinsfile
 *   checkout scm      : infra-statistics/Jenkinsfile
 *                       repository-permissions-updater/Jenkinsfile
 *   publishReports    : repository-permissions-updater/Jenkinsfile
 *                       publishReports([...], [useWorkloadIdentity: true])
 *   archiveArtifacts  : pipeline-steps-doc-generator/Jenkinsfile
 *   mail on failure   : jenkins.io/Jenkinsfile
 *   cleanWs           : standard Jenkins workspace cleanup step
 */

properties([
    pipelineTriggers([cron('H 1 * * 0')]),
    buildDiscarder(logRotator(numToKeepStr: '10')),
])

node('linux') {
    try {

        stage('Checkout') {
            // Checks out metadata-plugin-modernizer into the workspace root.
            // The workspace IS the data — no separate fetch step needed.
            // Jenkinsfile.fetch-publish and scripts/consolidate.py live here
            // alongside the plugin data they process.
            //
            // Reference: infra-statistics/Jenkinsfile — checkout scm as the
            // first stage; the repo contains both scripts and the data.
            checkout scm
        }

        stage('Validate Structure') {
            // Validate that expected data structure is present before running
            // the transform. Catches corrupt/incomplete checkouts and upstream
            // format changes in summary.md early — before any Python runs.
            sh '''
                set -euo pipefail

                [ -f "reports/summary.md" ] || {
                    echo "[ERROR] reports/summary.md not found in workspace."
                    exit 1
                }
                [ -d "reports/recipes" ] || {
                    echo "[ERROR] reports/recipes/ not found in workspace."
                    exit 1
                }

                # Validate required section headings in summary.md.
                SUMMARY="reports/summary.md"
                for section in \
                    "## Overview" \
                    "## Failures by Recipe" \
                    "## Plugins with Failed Migrations" \
                    "## Pull Request Statistics"
                do
                    if ! grep -qF "${section}" "${SUMMARY}"; then
                        echo "[ERROR] Missing section '${section}' in summary.md"
                        echo "[ERROR] Upstream format may have changed. First 30 lines:"
                        head -30 "${SUMMARY}"
                        exit 1
                    fi
                done
                echo "[OK] summary.md structure validated."

                # Confirm at least one plugin directory with reports/ exists.
                PLUGIN_COUNT=0
                for dir in */; do
                    name="${dir%/}"
                    case "$name" in .github|reports|.git|scripts) continue ;; esac
                    [ -d "${name}/reports" ] && PLUGIN_COUNT=$((PLUGIN_COUNT + 1))
                done
                [ "${PLUGIN_COUNT}" -ge 1 ] || {
                    echo "[ERROR] No plugin directories with reports/ found."
                    exit 1
                }
                echo "[OK] Found ${PLUGIN_COUNT} plugin(s) with reports/."
            '''
        }

        stage('Transform Data') {
            // INPUT_DIR=.  → consolidate.py reads from workspace root (the data).
            // OUTPUT_DIR   → absolute path outside workspace so generated JSON
            //                is never mistaken for plugin data by the script,
            //                and is never accidentally committed or published
            //                as part of the SCM checkout.
            //
            // Python 3 is available on all jenkins-infra linux agents.
            // Reference: infra-statistics/Jenkinsfile — runs processing scripts
            // against workspace data without additional tool setup.
            withEnv([
                'INPUT_DIR=.',
                'OUTPUT_DIR=/tmp/plugin-modernizer-stats',
            ]) {
                sh 'python3 --version'
                sh 'python3 scripts/consolidate.py'
            }
        }

        stage('Validate JSON') {
            // Independent second-pass validation — does not trust
            // consolidate.py's own internal post-write round-trip check.
            // python3 -m json.tool requires no additional installation.
            sh '''
                set -euo pipefail
                python3 -m json.tool \
                    < /tmp/plugin-modernizer-stats/summary.json > /dev/null
                echo "OK: summary.json"
                python3 -m json.tool \
                    < /tmp/plugin-modernizer-stats/plugin-recipes-index.json > /dev/null
                echo "OK: plugin-recipes-index.json"
            '''
        }

        stage('Publish') {
            // Reference: repository-permissions-updater/Jenkinsfile —
            //   publishReports(['...'], [useWorkloadIdentity: true])
            //
            // Non-trusted fallback: pipeline-steps-doc-generator/Jenkinsfile —
            //   archiveArtifacts when not running on trusted.ci.
            if (infra.isTrusted()) {
                dir('/tmp') {
                    publishReports(
                        ['plugin-modernizer-stats'],
                        [useWorkloadIdentity: true]
                    )
                }
                echo 'Published → reports.jenkins.io/plugin-modernizer-stats/'
            } else {
                sh 'cd /tmp && zip -r plugin-modernizer-stats.zip plugin-modernizer-stats/'
                archiveArtifacts artifacts: '/tmp/plugin-modernizer-stats.zip',
                                 fingerprint: true
                echo 'Non-trusted build: artifact archived locally.'
            }
        }

    } catch (err) {
        currentBuild.result = 'FAILURE'
        throw err

    } finally {
        if (currentBuild.result == 'FAILURE') {
            // Reference: jenkins.io/Jenkinsfile —
            //   mail to: 'infra@lists.jenkins-ci.org'
            mail(
                subject: "${env.JOB_NAME} #${env.BUILD_NUMBER} failed",
                body:    "ETL pipeline failed.\nBuild: ${env.BUILD_URL}",
                to:      'infra@lists.jenkins-ci.org',
            )
        }
        // Clean generated output from /tmp only — NOT the workspace.
        // The workspace is the SCM checkout; Jenkins manages it via cleanWs().
        sh 'rm -rf /tmp/plugin-modernizer-stats /tmp/plugin-modernizer-stats.zip'
        cleanWs()
    }
}
